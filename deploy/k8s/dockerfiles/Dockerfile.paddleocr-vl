# PaddleOCR-VL-1.5 FastAPI 서버 이미지
# paddleocr 패키지 사용 (transformers 버전 충돌 없음)
# CPU only, 0.9B 파라미터, ~3-4GB RAM

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        wget \
    && rm -rf /var/lib/apt/lists/*

# PaddlePaddle CPU 버전
RUN pip install --no-cache-dir paddlepaddle==3.1.0 \
    -i https://www.paddlepaddle.org.cn/packages/stable/cpu/

# PaddleOCR doc-parser (PP-StructureV3 포함)
RUN pip install --no-cache-dir "paddleocr[doc-parser]"

# FastAPI
RUN pip install --no-cache-dir \
    pillow \
    fastapi \
    "uvicorn[standard]" \
    python-multipart \
    pydantic

WORKDIR /app
COPY k8s/paddleocr_vl_server.py ./server.py

# PaddleOCR 모델 캐시: ~/.paddleocr → /models/.paddleocr (PVC 마운트 경로)
ENV HOME=/models
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-keep-alive", "300"]
