# GOT-OCR2.0 FastAPI 서버 이미지
# transformers >= 4.49 (v4 범위, 기존 환경 호환)
# CPU only, 580M 파라미터, ~2.5GB RAM

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch (크기 절감)
RUN pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir \
    "transformers>=4.49.0" \
    "accelerate>=0.26.0" \
    pillow \
    fastapi \
    "uvicorn[standard]" \
    python-multipart \
    pydantic

WORKDIR /app
COPY k8s/got_ocr2_server.py ./server.py

ENV HF_HOME=/models
ENV TRANSFORMERS_OFFLINE=0
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-keep-alive", "300"]
