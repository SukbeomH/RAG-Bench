# DeepSeek-OCR-2 FastAPI 서버 이미지
# GPU 필수: CUDA 11.8+ / flash-attn 2.7.3
# 모델: deepseek-ai/DeepSeek-OCR-2 (HuggingFace)

FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
        python3-pip \
        libgl1 \
        libglib2.0-0 \
        git \
        wget \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf python3.11 /usr/bin/python3 \
    && ln -sf python3 /usr/bin/python

# PyTorch 2.6.0 (CUDA 11.8)
RUN pip install --no-cache-dir \
    torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0 \
    --index-url https://download.pytorch.org/whl/cu118

# flash-attn 2.7.3 (DeepSeek-OCR-2 필수)
RUN pip install --no-cache-dir flash-attn==2.7.3 --no-build-isolation

# transformers >= 4.51.1 + 기타 의존성
RUN pip install --no-cache-dir \
    "transformers>=4.51.1" \
    accelerate \
    safetensors \
    tiktoken \
    pillow \
    fastapi \
    "uvicorn[standard]" \
    python-multipart \
    pydantic

WORKDIR /app
COPY k8s/deepseek_ocr2_server.py ./server.py

# HuggingFace 캐시 → PVC 마운트 경로
ENV HF_HOME=/models/hf
ENV TRANSFORMERS_CACHE=/models/hf
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-keep-alive", "600"]
