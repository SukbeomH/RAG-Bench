# syntax=docker/dockerfile:1
# PDF Parser Benchmark Worker
# PDF 백엔드 벤치마크를 K8s Job으로 실행하기 위한 워커 이미지.
#
# Build (프로젝트 루트에서):
#   docker buildx build --platform linux/amd64 \
#     -t $HARBOR_REGISTRY/rag-bench-test/pdf-parser:latest \
#     -f deploy/k8s/dockerfiles/Dockerfile.pdf-parser --load .

# ── Stage 1: 빌드 ──
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        g++ git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# PyTorch CPU-only (이미지 크기 절감, torchvision 포함 — docling 표 구조 모델 필요)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu

# PDF 파서 의존성
COPY deploy/k8s/requirements-pdf-parser.txt ./requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

# autorag-pdf-eval + autorag-parsers 패키지 설치
# docling은 all에서 제외 (transformers ↔ langchain-upstage tokenizers 충돌)
# Docker 환경에서는 langchain-upstage 불필요하므로 docling을 별도 설치
COPY packages/pdf-eval/ ./packages/pdf-eval/
COPY packages/pdf-parsers/ ./packages/pdf-parsers/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir "./packages/pdf-parsers[all,docling]" ./packages/pdf-eval

# ── Stage 2: 런타임 ──
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# 벤치마크 PDF + GT 복사
COPY data/benchmark_pdfs/       ./benchmark_pdfs/

# 워커 엔트리포인트
COPY orchestrators/pdf_parser/entrypoint.py     ./pdf_parser_entrypoint.py

ENV RESULTS_DIR=/results
ENV BENCHMARK_PDFS_DIR=/app/benchmark_pdfs

RUN mkdir -p /results

ENTRYPOINT ["python", "-u", "pdf_parser_entrypoint.py"]
